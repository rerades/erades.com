---
import { type CollectionEntry, getCollection } from "astro:content";
import BlogPost from "../../../layouts/BlogPost.astro";
import Footer from "../../../components/Footer.astro";
import { render } from "astro:content";
import { getImage } from "astro:assets";
import { resolveHeroImage } from "../../../utils/hero-image";
import { readingTime } from "../../../utils/reading-time";
import { relatedPosts } from "../../../utils/related-posts";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const langs = ["es", "en"];
  return langs.flatMap((lang) =>
    posts
      // Listings, RSS and search already drop drafts. Without this filter
      // getStaticPaths prerendered them too, so a URL like
      // /es/blog/funcional/monadas/ served unpublished markdown.
      .filter(
        (post) => post.id.startsWith(`${lang}/`) && !post.data.draft
      )
      .map((post) => ({
        params: { lang, slug: post.id.replace(`${lang}/`, "") },
        props: post,
      }))
  );
}
type Props = CollectionEntry<"blog">;

const { lang: langParam } = Astro.params;
const lang = langParam ?? "es";
const post = Astro.props;

// Cada idioma tiene su slug, así que la traducción se busca por
// `translationKey` y no cambiando el prefijo de la URL.
const postPath = (p: CollectionEntry<"blog">): string => {
  const [postLang = "", ...rest] = p.id.split("/");
  return `/${postLang}/blog/${rest.join("/")}/`;
};
const translationKey = post?.data?.translationKey;
const allPosts = await getCollection("blog");
const translation = translationKey
  ? allPosts.find(
      (p) =>
        !p.data.draft &&
        p.data.translationKey === translationKey &&
        !p.id.startsWith(`${lang}/`)
    )
  : undefined;
const alternates = translation
  ? [
      { lang, href: postPath(post) },
      { lang: translation.id.split("/")[0] ?? "", href: postPath(translation) },
    ]
  : [];

// La portada como og:image. El frontmatter dice `/hero-x.webp`, pero esa ruta no
// existe en public/ (las portadas viven en src/assets/heroes), así que hay que
// resolverla y procesarla. 1200x630 en JPG: el tamaño que piden LinkedIn y X, y
// un formato que leen todos los scrapers, cosa que con WebP no está garantizada.
const heroSrc = resolveHeroImage(post?.data?.heroImage);
const ogImage = heroSrc
  ? await getImage({ src: heroSrc, width: 1200, height: 630, format: "jpg" })
  : undefined;

let Content, headings, pubDate, updatedDate, dataWithDates;
if (post && post.data) {
  ({ Content, headings } = await render(post));
  pubDate = post.data.pubDate ? new Date(post.data.pubDate) : undefined;
  updatedDate = post.data.updatedDate
    ? new Date(post.data.updatedDate)
    : undefined;
  dataWithDates = {
    ...post.data,
    pubDate,
    ...(updatedDate ? { updatedDate } : {}),
  };
}
---

{
  !post || !post.data ? (
    <html lang={lang}>
      <body class="bg-background text-foreground min-h-screen flex flex-col">
        <main class="max-w-2xl mx-auto pt-16 px-4 text-center">
          <h2 class="text-3xl font-bold mb-4">Post no encontrado</h2>
          <p class="text-muted-foreground">
            No se encontró el post solicitado. Verifica la URL o vuelve al{" "}
            <a href="/blog/" class="text-primary underline">
              listado de posts
            </a>
            .
          </p>
        </main>
        <Footer lang={lang as "es" | "en"} />
      </body>
    </html>
  ) : !pubDate ? (
    <html lang={lang}>
      <body class="bg-background text-foreground min-h-screen flex flex-col">
        <main class="max-w-2xl mx-auto pt-16 px-4 text-center">
          <h2 class="text-3xl font-bold mb-4">Post inválido</h2>
          <p class="text-muted-foreground">
            El post no tiene fecha de publicación. Vuelve al{" "}
            <a href="/blog/" class="text-primary underline">
              listado de posts
            </a>
            .
          </p>
        </main>
        <Footer lang={lang as "es" | "en"} />
      </body>
    </html>
  ) : (
    <BlogPost
      lang={lang}
      title={dataWithDates?.title || ""}
      description={dataWithDates?.description || ""}
      pubDate={dataWithDates?.pubDate}
      tags={dataWithDates?.tags || []}
      categories={dataWithDates?.categories || []}
      draft={!!dataWithDates?.draft}
      updatedDate={dataWithDates?.updatedDate}
      alternates={alternates}
      heroImage={ogImage?.src}
      readingTime={readingTime(post.body ?? "")}
      headings={headings}
      related={relatedPosts(post, allPosts)}
    >
      {Content ? <Content /> : null}
    </BlogPost>
  )
}
