---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/BlogLayout.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import { t, tWithInterpolation } from "../../../i18n";
import { seriesIds, seriesPosts } from "../../../utils/series";

// Prerenderizada: las series salen del frontmatter, que no cambia entre
// builds. El `id` de la serie es el mismo en los dos idiomas, así que la URL
// también lo es y BlogLayout ya emite el hreflang correcto.
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return ["es", "en"].flatMap((lang) =>
    seriesIds(lang, posts).map((id) => ({ params: { lang, id } }))
  );
}

const lang = Astro.params.lang === "en" ? "en" : "es";
const id = Astro.params.id ?? "";
const posts = seriesPosts(id, lang, await getCollection("blog"));
const name = t(lang, `series.${id}`);
const description = t(lang, `seriesDescription.${id}`);
const href = (postId: string): string =>
  `/${lang}/blog/${postId.slice(lang.length + 1)}/`;
---

<Layout
  lang={lang}
  frontmatter={{ title: name, description, tags: [], categories: [], draft: false }}
>
  <section class="not-prose max-w-3xl mx-auto" data-testid="series-index">
    <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
      {tWithInterpolation(lang, "seriesPage.eyebrow", { total: String(posts.length) })}
    </p>
    <h1 class="font-serif text-4xl font-bold mt-2">{name}</h1>
    <p class="mt-4 text-lg text-muted-foreground">{description}</p>
    <ol class="mt-10 list-none border-l-2 border-primary">
      {
        posts.map((post, i) => (
          <li class="pl-6 pb-8 last:pb-0">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              {tWithInterpolation(lang, "seriesPage.part", { part: String(i + 1) })}
              {" · "}
              <FormattedDate date={post.data.pubDate} lang={lang} />
            </p>
            <a href={href(post.id)} class="mt-1 block font-serif text-2xl font-bold hover:text-primary hover:underline">
              {post.data.title}
            </a>
            <p class="mt-2 text-muted-foreground">{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
