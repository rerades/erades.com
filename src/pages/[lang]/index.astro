---
import Layout from "../../layouts/BlogPost.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import { t, tWithInterpolation } from "../../i18n";
import { getImage } from "astro:assets";
import { resolveHeroImage } from "../../utils/hero-image";
import { sortPosts } from "../../utils/sort-utils";

// Estática: antes se renderizaba en cada petición solo para servir un 404 con
// el idioma de la cookie cuando el parámetro no era es/en, y eso ya lo cubre
// 404.astro. Prerenderizada, la portada del LCP sale en el build como fichero
// en /_astro/ en vez de pasar por sharp en /_image en cada visita.
export const prerender = true;

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as "es" | "en";

const posts = sortPosts(
  (await getCollection("blog")).filter(
    (p) => !p.data.draft && p.id.startsWith(`${lang}/`)
  ),
  "date-desc"
);
const featured = posts.slice(0, 3);

// La portada de la primera tarjeta es el LCP de la home en móvil. Se precarga
// con los mismos parámetros que BlogCardGrid (400x225, 1x y 2x) para que el
// navegador reutilice la descarga en vez de pedirla dos veces.
const lcpHero = featured[0]?.data.heroImage;
const lcpSrc = lcpHero ? resolveHeroImage(lcpHero) : undefined;
const lcpImage =
  lcpSrc && typeof lcpSrc !== "string"
    ? await getImage({ src: lcpSrc, width: 400, height: 225, densities: [1, 2] })
    : undefined;
---

<Layout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  tags={[]}
  categories={[]}
  draft={false}
  lang={lang}
  preloadImage={lcpImage && { src: lcpImage.src, srcset: lcpImage.srcSet.attribute }}
>
  <section>
      <div class="mx-auto">
        <!-- Hero Section -->
        <div class="text-center mb-16">
          <h1
            class="font-serif text-4xl md:text-6xl font-bold text-foreground mb-6"
          >
            {
              tWithInterpolation(lang, "home.hero.title", {
                siteTitle: SITE_TITLE,
              })
            }
          </h1>
          <p
            class="text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed"
          >
            {t(lang, "home.hero.description")}
          </p>
        </div>

        <!-- Featured Content -->
        <!-- Solo para lectores de pantalla: los títulos de las tarjetas son h3 y
             colgaban directamente del h1 (Lighthouse: heading-order). -->
        <h2 class="sr-only">{t(lang, "home.featured.title")}</h2>
        <ul class="decoration-none grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            featured.map((post, index) => (
              <li>
                <BlogCard post={post} variant="grid" lang={lang} index={index} />
              </li>
            ))
          }
        </ul>

        <!-- Call to Action -->
        <div class="text-center mt-16">
          <div class="bg-card rounded-xl p-8 shadow-medium">
            <h2
              class="font-serif text-2xl font-semibold text-card-foreground mb-4"
            >
              {t(lang, "home.cta.title")}
            </h2>
            <p class="text-muted-foreground mb-12">
              {t(lang, "home.cta.description")}
            </p>
            <a
              href={`/${lang}/blog/`}
              class="inline-block capitalize px-8 py-4 rounded-md border font-medium transition-colors bg-secondary text-secondary-foreground hover:bg-primary/10"
            >
              {t(lang, "home.cta.button")}
            </a>
          </div>
        </div>
      </div>
  </section>
</Layout>
