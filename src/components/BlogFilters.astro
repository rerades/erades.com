---
import { ArrowDownWideNarrow } from "@lucide/astro";
import { NativeSelect, NativeSelectOption } from "./ui/native-select";
import ViewModeToggle from "./ViewModeToggle.astro";
import ShowWhen from "./ShowWhen.astro";
import { t } from "../i18n";
interface Props {
  categories: string[];
  selectedCategory: string;
  sortBy: string;
  viewMode: string;
  tag?: string;
  getCategoryHref?: (cat: string) => string;
  customClass?: string;
  lang?: "es" | "en";
}
const {
  categories,
  selectedCategory,
  sortBy,
  viewMode,
  tag,
  getCategoryHref,
  customClass,
  lang = "es",
} = Astro.props as Props;

function getCategoryHrefLocal(cat: string) {
  if (!tag) return getCategoryHref ? getCategoryHref(cat) : "#";
  if (cat === "Todas") {
    return `/tags/${tag}/` + (sortBy ? `?sortBy=${sortBy}` : "");
  }
  return `/tags/${tag}/${cat}/` + (sortBy ? `?sortBy=${sortBy}` : "");
}
---

<form
  id="filters"
  method="get"
  class={`bg-white dark:bg-gray-700 flex flex-wrap gap-4 items-start md:items-center justify-between mb-8 p-4 bg-card rounded-lg border ${customClass || ""}`}
>
  <div class="flex flex-col gap-4 min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2 min-w-0">
      <span class="text-sm text-muted-foreground">{t(lang, "filters.category")}</span>
      <div class="flex flex-wrap gap-2 min-w-0">
        {
          categories.map((category) => (
            <a
              href={getCategoryHrefLocal(category)}
              class={`w-fit whitespace-nowrap capitalize px-3 py-1 rounded-md border text-sm transition-colors ${selectedCategory.trim().toLowerCase() === category.trim().toLowerCase() ? "bg-primary text-primary-foreground" : "bg-secondary text-secondary-foreground hover:bg-primary/10"}`}
              aria-current={
                selectedCategory.trim().toLowerCase() ===
                category.trim().toLowerCase()
                  ? "page"
                  : undefined
              }
              tabindex={0}
            >
              {category === "Todas" ? t(lang, "filters.all") : category}
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="flex flex-wrap items-center justify-end gap-4 min-w-0">
    <div class="flex items-center gap-2 justify-end min-w-0">
      <span class="text-sm text-muted-foreground flex items-center shrink-0">
        <ArrowDownWideNarrow class="h-4 w-4 text-muted-foreground" />
      </span>
      {/*
        El <select> sigue siendo nativo: el teclado y la accesibilidad los pone
        el navegador. Lo que aporta NativeSelect es el envoltorio relativo y el
        chevron absoluto, que aquí estaban escritos a mano.
      */}
      <NativeSelect
        name="sortBy"
        class="w-40 max-w-full min-w-0"
        onchange="this.form.submit()"
      >
        <NativeSelectOption value="date-desc" selected={sortBy === "date-desc"}
          >{t(lang, "filters.sort.dateDesc")}</NativeSelectOption
        >
        <NativeSelectOption value="date-asc" selected={sortBy === "date-asc"}
          >{t(lang, "filters.sort.dateAsc")}</NativeSelectOption
        >
        <NativeSelectOption value="title" selected={sortBy === "title"}
          >{t(lang, "filters.sort.title")}</NativeSelectOption
        >
      </NativeSelect>
    </div>
    <!-- Selector visual grid/lista -->
    <ViewModeToggle viewMode={viewMode} lang={lang} />
  </div>
  {/* Mantener los parámetros de búsqueda y categoría en el formulario */}
  <ShowWhen when={Astro.url.searchParams.get("q")}>
    <input type="hidden" name="q" value={Astro.url.searchParams.get("q")!} />
  </ShowWhen>
  <ShowWhen when={Astro.url.searchParams.get("category")}>
    <input
      type="hidden"
      name="category"
      value={Astro.url.searchParams.get("category")!}
    />
  </ShowWhen>
  <ShowWhen when={viewMode === "list"}>
    <input type="hidden" name="viewMode" value="list" />
  </ShowWhen>
</form>
