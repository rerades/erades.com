---
import HeaderLink from "./HeaderLink.astro";
import HeaderSearchBox from "./HeaderSearchBox.astro";
import { Menu, X } from "@lucide/astro";
import Linkedin from "./LinkedinIcon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SocialProfileMenu from "./SocialProfileMenu.astro";
import {
  Dialog,
  DialogContent,
  DialogTitle,
} from "./ui/dialog";
import { t } from "../i18n";
import logoImage from "../assets/area73-small.png";
import avatarImage from "../assets/avatar.png";

interface Props {
  lang: string;
}
const { lang } = Astro.props;

let isDark = false;
if (typeof window !== "undefined") {
  isDark = window.document.documentElement.classList.contains("dark");
}
---

<header
  aria-label="header"
  class="w-full sticky top-0 z-40 bg-header-background border-b border-header-border shadow-[0_2px_8px_rgba(0,0,0,0.04)] backdrop-blur supports-[backdrop-filter]:bg-header-background/80"
>
  <div
    class="max-w-[1440px] mx-auto w-full grid grid-cols-[max-content_max-content_auto_min-content] items-center px-6 py-4"
  >
    <div class="flex items-center gap-6 min-w-0">
      <a
        href="/"
        class="flex items-center gap-2 font-bold text-lg whitespace-nowrap"
      >
        <img
          loading="eager"
          src={logoImage.src}
          alt={t(lang as "en" | "es", "logo.alt")}
          class="h-12 w-12 object-contain"
          width="48"
          height="48"
          decoding="async"
          fetchpriority="high"
        />
      </a>
    </div>

    <!-- Mobile Search Box -->
    <div class="flex-1 ml-4 md:hidden">
      <HeaderSearchBox lang={lang} />
    </div>

    <!-- Desktop Navigation -->
    <nav
      class="hidden md:flex mx-8 items-center gap-6 md:gap-4 xl:gap-6 text-[16px] font-medium font-[Inter] text-muted-foreground"
    >
      <HeaderLink
        href={`/${lang}`}
        aria-label={t(lang as "en" | "es", "menu.home")}
        lang={lang}
      >
        {t(lang as "en" | "es", "menu.home")}
      </HeaderLink>
      <HeaderLink
        href={`/${lang}/blog`}
        aria-label={t(lang as "en" | "es", "menu.blog")}
        lang={lang}
      >
        {t(lang as "en" | "es", "menu.blog")}
      </HeaderLink>
      <HeaderLink
        href={`/${lang}/about`}
        aria-label={t(lang as "en" | "es", "menu.about")}
        lang={lang}
      >
        {t(lang as "en" | "es", "menu.about")}
      </HeaderLink>
      <HeaderLink
        href={`/${lang}/tags`}
        aria-label={t(lang as "en" | "es", "menu.tags")}
        lang={lang}
      >
        {t(lang as "en" | "es", "menu.tags")}
      </HeaderLink>
    </nav>

    <div class="grid grid-cols-[auto_max-content] items-center gap-0 min-w-0">
      <div class="hidden md:block">
        <div class="w-full">
          <HeaderSearchBox lang={lang} />
        </div>
      </div>
      <div class="flex items-center gap-0 max-[555px]:hidden">
        <ThemeToggle />
        <div class="flex items-center gap-1 ml-2">
          <button
            data-lang-switch="es"
            class={"px-2 py-1 rounded text-xs font-bold transition " +
              (lang === "es"
                ? "bg-primary text-primary-foreground"
                : "bg-muted text-muted-foreground hover:bg-accent")}
            aria-current={lang === "es" ? "page" : undefined}
          >
            ES
          </button>
          <button
            data-lang-switch="en"
            class={"px-2 py-1 rounded text-xs font-bold transition " +
              (lang === "en"
                ? "bg-primary text-primary-foreground"
                : "bg-muted text-muted-foreground hover:bg-accent")}
            aria-current={lang === "en" ? "page" : undefined}
          >
            EN
          </button>
          <!-- Un unico listener delegado: los botones de idioma existen dos
               veces (escritorio y menu movil) y getElementById solo devolvia el
               primero, dejando los del movil sin comportamiento. -->
          <script is:inline>
            document.addEventListener("click", (e) => {
              const btn = e.target.closest?.("[data-lang-switch]");
              if (!btn) return;
              const next = btn.dataset.langSwitch;
              document.cookie =
                "lang=" + next + "; path=/; max-age=" + 60 * 60 * 24 * 365;
              window.location.pathname = window.location.pathname.replace(
                /^\/(en|es)/,
                "/" + next
              );
            });
          </script>
          <SocialProfileMenu
            name="Rodrigo Erades"
            email="rerades@siete3.com"
            linkedinUrl="https://www.linkedin.com/in/siete3/"
            xUrl="https://x.com/area_73"
            lang={lang}
            avatarSrc={avatarImage.src}
          />
        </div>
      </div>
    </div>

    {/*
      El disparador y el contenido tienen que colgar de la misma raíz
      `data-slot="dialog"`. Con esto desaparecen: el `aria-hidden="true"`
      que el toggle nunca actualizaba (el menú abierto se anunciaba como
      oculto), el `window.toggleMobileMenu` global, y el manejo a mano de
      `document.body.style.overflow`. El runtime aporta además focus trap,
      `aria-modal` y devolución del foco al cerrar.
    */}
    <Dialog id="mobile-menu" class="md:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        data-slot="dialog-trigger"
        class="flex items-center justify-center w-10 h-10 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
        aria-label="Toggle mobile menu"
      >
        <Menu class="h-6 w-6" />
      </button>

      <DialogContent
        id="mobile-menu-overlay"
        class="inset-0 top-0 left-0 w-full max-w-none translate-x-0 translate-y-0 gap-0 overflow-y-auto rounded-none bg-header-background p-0 ring-0 flex flex-col"
      >
        <div class="flex items-center justify-between p-6">
          <DialogTitle class="text-lg font-semibold text-foreground">
            Menu
          </DialogTitle>
        </div>

    <!-- Mobile Navigation Links -->
    <nav class="flex flex-col items-center justify-center flex-1 space-y-8">
      <HeaderLink
        href={`/${lang}`}
        aria-label={t(lang as "en" | "es", "menu.home")}
        lang={lang}
        class="block py-4 text-2xl font-semibold text-foreground hover:text-primary transition-colors"
      >
        {t(lang as "en" | "es", "menu.home")}
      </HeaderLink>
      <HeaderLink
        href={`/${lang}/blog`}
        aria-label={t(lang as "en" | "es", "menu.blog")}
        lang={lang}
        class="block py-4 text-2xl font-semibold text-foreground hover:text-primary transition-colors"
      >
        {t(lang as "en" | "es", "menu.blog")}
      </HeaderLink>
      <HeaderLink
        href={`/${lang}/about`}
        aria-label={t(lang as "en" | "es", "menu.about")}
        lang={lang}
        class="block py-4 text-2xl font-semibold text-foreground hover:text-primary transition-colors"
      >
        {t(lang as "en" | "es", "menu.about")}
      </HeaderLink>
      <HeaderLink
        href={`/${lang}/tags`}
        aria-label={t(lang as "en" | "es", "menu.tags")}
        lang={lang}
        class="block py-4 text-2xl font-semibold text-foreground hover:text-primary transition-colors"
      >
        {t(lang as "en" | "es", "menu.tags")}
      </HeaderLink>
      <div class="min-[555px]:hidden grid grid-cols-[auto_auto] gap-2">
        <a
          href="https://www.linkedin.com/in/siete3/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 text-sm text-foreground hover:bg-muted transition-colors font-medium"
          aria-label={t(lang as "en" | "es", "social.linkedin")}
          title={t(lang as "en" | "es", "social.linkedin")}
        >
          <Linkedin class="h-4 w-4 text-muted-foreground" />
          LinkedIn
        </a>
        <a
          href="https://x.com/area_73"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 text-sm text-foreground hover:bg-muted transition-colors font-medium"
          aria-label={t(lang as "en" | "es", "social.x")}
          title={t(lang as "en" | "es", "social.x")}
        >
          <X class="h-4 w-4 text-muted-foreground" />
          X
        </a>
      </div>
      <div class="min-[555px]:hidden grid grid-cols-[auto_auto] gap-2">
        <button
          data-lang-switch="es"
          class={"px-2 py-1 rounded text-xs font-bold transition " +
            (lang === "es"
              ? "bg-primary text-primary-foreground"
              : "bg-muted text-muted-foreground hover:bg-accent")}
          aria-current={lang === "es" ? "page" : undefined}
        >
          ES
        </button>
        <button
          data-lang-switch="en"
          class={"px-2 py-1 rounded text-xs font-bold transition " +
            (lang === "en"
              ? "bg-primary text-primary-foreground"
              : "bg-muted text-muted-foreground hover:bg-accent")}
          aria-current={lang === "en" ? "page" : undefined}
        >
          EN
        </button>
      </div>
    </nav>
      </DialogContent>
    </Dialog>
  </div>

  <script is:inline>
    // Lo único que el runtime del diálogo no cubre: al pasar a desktop el
    // menú móvil deja de tener sentido, y sus enlaces navegan, así que hay
    // que cerrarlo en ambos casos.
    (() => {
      const dialog = document.getElementById("mobile-menu");
      if (!dialog) return;

      const close = () =>
        dialog.dispatchEvent(
          new CustomEvent("dialog:set", { detail: { open: false } })
        );

      dialog
        .querySelectorAll('[data-slot="dialog-content"] a, [data-slot="dialog-content"] button')
        .forEach((el) => el.addEventListener("click", close));

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) close();
      });
    })();
  </script>
</header>
