---
import ShowWhen from "./ShowWhen.astro";
import { t } from "../i18n";
interface Props {
  shown: number;
  total: number;
  query?: string;
  lang?: "es" | "en";
}
const { shown, total, query, lang = "es" } = Astro.props as Props;
// "Mostrando {shown} de {total} resultados" -> ["Mostrando ", " de ", " resultados"]
const [before, middle, after] = t(lang, "results.showing").split(
  /\{shown\}|\{total\}/
);
---

<p class="text-muted-foreground">
  {before}<span class="text-primary">{shown}</span>{middle}<span
    class="text-primary">{total}</span
  >{after}
  <ShowWhen when={query}>
    <span>
      {t(lang, "results.for")}
      <span class="text-primary">{query}</span></span
    >
  </ShowWhen>
</p>
