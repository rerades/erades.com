---
/**
 * @component NoResults
 * @title No Results
 * @description El estado vacío de un listado: un mensaje y, si se le da `onResetHref`, un enlace para quitar los filtros.
 *
 *
 * @usage
 *
 * ```astro
 * ---
 * import NoResults from "./NoResults.astro";
 * ---
 *
 * <NoResults onResetHref="/es/blog" lang="es" />
 * ```
 */
import { Search as SearchIcon } from "@lucide/astro";
import { t } from "../i18n";

interface Props {
  onResetHref?: string;
  lang?: "es" | "en";
}
const {
  onResetHref = "?category=all",
  lang = "es",
} = Astro.props as Props;
---

<SearchIcon class="mx-auto mb-4 text-muted-foreground h-12 w-12 stroke-2" />
<h3 class="font-serif text-xl font-semibold text-foreground mb-2">
  {t(lang, "results.none")}
</h3>
<p class="text-muted-foreground mb-6">
  {t(lang, "results.noneHint")}
</p>
<a
  href={onResetHref}
  class="px-4 py-2 rounded-md border bg-muted text-muted-foreground hover:bg-primary/10 transition"
>
  {t(lang, "results.showAll")}
</a>
