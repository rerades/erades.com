---
import { getCollection } from "astro:content";
import BlogCard from "../../BlogCard.astro";

const posts = (await getCollection("blog"))
  .filter((post) => post.id.startsWith("es/") && !post.data.draft)
  .slice(0, 2);
---

<div class="space-y-8">
  <div>
    <p class="mb-2 text-xs text-muted-foreground">variant="grid" (por defecto)</p>
    <div class="grid gap-6 sm:grid-cols-2">
      {posts.map((post, index) => <BlogCard post={post} lang="es" index={index} />)}
    </div>
  </div>

  <div>
    <p class="mb-2 text-xs text-muted-foreground">variant="list"</p>
    <div class="space-y-6">
      {posts.map((post, index) => <BlogCard post={post} variant="list" lang="es" index={index} />)}
    </div>
  </div>
</div>
