---
import tags from "@lucide/astro/icons/tags";
import FormattedDate from "./FormattedDate.astro";
import ShowWhen from "./ShowWhen.astro";
import { Image } from "astro:assets";
import { EAGER_LOAD_IMAGES_COUNT } from "../consts";
import { tWithInterpolation } from "../i18n";

interface Props {
  post: any;
  lang: string;
  index: number;
}
const { post, lang, index } = Astro.props;
const uiLang = lang === "en" ? "en" : "es";
const langPrefix = `${lang}/`;
const postId = post && typeof post.id === "string" ? post.id : "";
const href = `/${lang}/blog/${postId.startsWith(langPrefix) ? postId.slice(langPrefix.length) : postId}/`;
const getReadTime = (content: string): number => {
  if (!content) return 1;
  const words = content.split(/\s+/).length;
  return Math.max(1, Math.round(words / 250));
};
// Permitir content en post o post.data
const content = post.content || (post.data && post.data.content) || "";
const readTime = getReadTime(content);
// Ensure categories and tags are always arrays
const categories = Array.isArray(
  post.categories || (post.data && post.data.categories)
)
  ? post.categories || (post.data && post.data.categories)
  : [];
const postTags = Array.isArray(post.tags || (post.data && post.data.tags))
  ? post.tags || (post.data && post.data.tags)
  : [];
---

<a href={href} class="block group h-full" aria-label="grid-card">
  <div
    class="h-full bg-card border rounded-xl shadow-soft hover:shadow-medium transition-shadow duration-300 overflow-hidden borderh-full flex flex-col"
  >
    <ShowWhen when={post.heroImage || (post.data && post.data.heroImage)}>
      <div
        class="aspect-video bg-gradient-to-br from-primary/10 to-accent rounded-t-xl overflow-hidden"
      >
        <Image
          src={post.heroImage || (post.data && post.data.heroImage)}
          alt={post.title || (post.data && post.data.title) || ""}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          width={400}
          height={225}
          loading={index < EAGER_LOAD_IMAGES_COUNT ? "eager" : "lazy"}
          fetchpriority={index < EAGER_LOAD_IMAGES_COUNT ? "high" : "auto"}
        />
      </div>
    </ShowWhen>
    <div class="p-6 flex flex-col flex-1">
      <ShowWhen when={categories.length > 0}>
        <div class="inline-flex flex-wrap gap-2 mb-2">
          {
            categories.map((category: string) => (
              <span
                class="inline-flex items-center px-2 py-0.5 rounded bg-secondary text-xs text-secondary-foreground font-medium whitespace-nowrap"
                title={tWithInterpolation(uiLang, "post.viewCategory", {
                  category,
                })}
              >
                {category}
              </span>
            ))
          }
        </div>
      </ShowWhen>
      <h3
        aria-label="blog-card-title"
        class="font-serif text-xl font-semibold text-foreground mb-3 group-hover:text-primary transition-colors line-clamp-2"
      >
        {post.title || (post.data && post.data.title) || ""}
      </h3>
      <div class="text-xs text-muted-foreground mb-2">
        <FormattedDate
          date={post.pubDate || (post.data && post.data.pubDate)
            ? new Date(post.pubDate || (post.data && post.data.pubDate))
            : new Date(0)}
          lang={lang}
        />
        <ShowWhen when={readTime}>
          <span class="ml-2"
            >· {
              tWithInterpolation(uiLang, "post.readTime", {
                minutes: String(readTime),
              })
            }</span
          >
        </ShowWhen>
        <ShowWhen when={post.author || (post.data && post.data.author)}>
          <span class="ml-2"
            >· {post.author || (post.data && post.data.author)}</span
          >
        </ShowWhen>
      </div>
      <p class="text-muted-foreground mb-4 text-sm leading-relaxed flex-1">
        {
          post.excerpt ||
            (post.data && post.data.excerpt) ||
            post.description ||
            (post.data && post.data.description) ||
            ""
        }
      </p>

      <ShowWhen when={postTags.length > 0}>
        <div class="inline-flex flex-wrap gap-2 mt-4">
          {
            postTags.map((tag: string) => (
              <span class="inline-flex items-center px-2 py-0.5 rounded bg-muted text-xs text-secondary-foreground border border-border">
                #{tag}
              </span>
            ))
          }
        </div>
      </ShowWhen>
    </div>
  </div>
</a>
