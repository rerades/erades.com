---
/**
 * @component Footer
 * @title Footer
 * @description Pie del sitio: copyright con el año actual y los enlaces sociales.
 *
 *
 * @usage
 *
 * ```astro
 * ---
 * import Footer from "./Footer.astro";
 * ---
 *
 * <Footer lang="es" />
 * ```
 */
import { X } from "@lucide/astro";
import Linkedin from "./LinkedinIcon.astro";
import { t } from "../i18n";

interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const year = new Date().getFullYear();
const links = [
  { href: `/${lang}`, key: "menu.home" },
  { href: `/${lang}/blog`, key: "menu.blog" },
  { href: `/${lang}/about`, key: "menu.about" },
  { href: `/${lang}/tags`, key: "menu.tags" },
];
---

<footer
  aria-label="footer"
  class="w-full mt-auto border-t border-header-border bg-header-background text-muted-foreground"
>
  <div class="max-w-[1440px] mx-auto w-full px-6 py-10 flex flex-col gap-8">
    <div
      class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
    >
      <a
        href={`/${lang}`}
        class="text-lg font-semibold tracking-tight text-foreground hover:text-primary transition-colors"
      >
        Area 73
      </a>

      <nav aria-label={t(lang, "footer.navTitle")}>
        <h2 class="sr-only">{t(lang, "footer.navTitle")}</h2>
        <ul
          class="decoration-none flex flex-wrap gap-x-8 gap-y-3 text-sm font-medium"
        >
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-foreground transition-colors"
                >
                  {t(lang, link.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="flex flex-col-reverse gap-4 border-t border-header-border pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-xs" data-testid="footer-copyright">
        &copy; {year} Rodrigo Erades. {t(lang, "footer.rights")}
      </p>

      <div class="flex items-center gap-2">
        <h2 class="sr-only">{t(lang, "footer.followTitle")}</h2>
        <a
          href="https://www.linkedin.com/in/siete3/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t(lang, "social.linkedin")}
          title={t(lang, "social.linkedin")}
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-header-border hover:text-foreground hover:border-foreground/30 transition-colors"
        >
          <Linkedin class="h-4 w-4" />
        </a>
        <a
          href="https://x.com/area_73"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t(lang, "social.x")}
          title={t(lang, "social.x")}
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-header-border hover:text-foreground hover:border-foreground/30 transition-colors"
        >
          <X class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</footer>
