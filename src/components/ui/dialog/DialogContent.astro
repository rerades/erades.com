---
// Generated from bejamas-juno style registry. Do not edit packages/ui/src/components/dialog/DialogContent.astro directly.
import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";

import DialogClose from "./DialogClose.astro";
import DialogOverlay from "./DialogOverlay.astro";
import { X } from "@lucide/astro";

interface Props extends HTMLAttributes<"div"> {
  showCloseButton?: boolean;
}

const {
  showCloseButton = true,
  class: className = "",
  ...rest
} = Astro.props as Props;
---

<div data-slot="dialog-portal" class="z-50 isolate absolute">
  <DialogOverlay />
  <div
    data-slot="dialog-content"
    hidden
    class={cn(
      // Podado respecto al registry: animate-in/out, fade-* y zoom-*
      // necesitan `tw-animate-css`, que no usamos (ver #164).
      "bg-background ring-foreground/10 grid max-w-[calc(100%-2rem)] gap-6 rounded-xl p-6 text-sm ring-1 sm:max-w-md fixed top-1/2 left-1/2 z-50 w-full -translate-x-1/2 -translate-y-1/2 outline-none",
      className,
    )}
    {...rest}
  >
    <slot />
    {
      showCloseButton && (
        <DialogClose>
          <X class="h-5 w-5" />
          <span class="sr-only">Close</span>
        </DialogClose>
      )
    }
  </div>
</div>
