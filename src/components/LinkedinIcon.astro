---
/**
 * @component LinkedinIcon
 * @title LinkedIn Icon
 * @description El logotipo de LinkedIn como SVG en línea. Existe porque `@lucide/astro` no trae marcas comerciales.
 *
 *
 * @usage
 *
 * ```astro
 * ---
 * import LinkedinIcon from "./LinkedinIcon.astro";
 * ---
 *
 * <LinkedinIcon class="h-5 w-5" />
 * ```
 */
// @lucide/astro 1.x elimino todos los iconos de marca, asi que el de LinkedIn
// se queda aqui. Es el mismo trazado que servia la 0.548, para que no cambie
// de aspecto respecto a los iconos de lucide que lleva al lado.
// Mismos atributos base que un icono de lucide: 24x24, trazo de currentColor.
interface Props {
  readonly class?: string;
}

const { class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
  ></path>
  <rect width="4" height="12" x="2" y="9"></rect>
  <circle cx="4" cy="4" r="2"></circle>
</svg>
