---
/**
 * @component GoogleAnalytics
 * @title Google Analytics
 * @description Carga GA4 solo si `PUBLIC_GA_MEASUREMENT_ID` está configurada: sin variable no emite ni una etiqueta. `gtag.js` se pide después del evento `load`, para no competir con el render ni con la imagen del LCP, y va con la IP anonimizada y las señales publicitarias desactivadas.
 *
 *
 * El condicional es un `ShowWhen` y no una expresión JSX envolvente por un motivo que está comentado en el fichero: dentro de una expresión, Astro emite el cuerpo del script literal en vez de evaluarlo.
 *
 * @usage
 *
 * ```astro
 * ---
 * import GoogleAnalytics from "./GoogleAnalytics.astro";
 * ---
 *
 * <GoogleAnalytics />
 * ```
 */
import ShowWhen from "./ShowWhen.astro";

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{/* El condicional va en ShowWhen y no en una expresion JSX envolvente: dentro
    de una expresion, el cuerpo del <script> se parsea como JSX y Astro >= 5.17.2
    lo emite literal en vez de evaluarlo. Como slot, es texto plano de script. */}
<ShowWhen when={gaMeasurementId}>
  {/* gtag.js pesa ~170 KB. Con `async` no bloqueaba el pintado, pero se
      descargaba a la vez que las fuentes y la portada del LCP y en móvil se
      quedaba con casi todo el ancho de banda. Tras `load` la página ya está
      pintada. La cola de dataLayer se crea ya, así que el page_view no se
      pierde: gtag.js la procesa al llegar. Lo que se pierde es la visita de
      quien se va antes de `load`, y se ha aceptado. */}
  <script is:inline define:vars={{ measurementId: gaMeasurementId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", measurementId, {
      send_page_view: true,
      anonymize_ip: true,
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });

    const loadGtag = () => {
      const script = document.createElement("script");
      script.async = true;
      script.src = "https://www.googletagmanager.com/gtag/js?id=" + measurementId;
      document.head.appendChild(script);
    };
    if (document.readyState === "complete") loadGtag();
    else window.addEventListener("load", loadGtag, { once: true });
  </script>
</ShowWhen>
