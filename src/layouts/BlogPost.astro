---
import type { CollectionEntry } from "astro:content";
import type { ComponentProps } from "astro/types";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ShowWhen from "../components/ShowWhen.astro";
import TableOfContents from "../components/TableOfContents.astro";
import type { MarkdownHeading } from "astro";
import ReadingTime from "../components/ReadingTime.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import { Image } from "astro:assets";
import "../styles/global.css";

type Props = Omit<CollectionEntry<"blog">["data"], "pubDate"> & {
  pubDate?: Date;
  lang: string;
  alternates?: ComponentProps<typeof BaseHead>["alternates"];
  preloadImage?: ComponentProps<typeof BaseHead>["preloadImage"];
  readingTime?: number;
  headings?: readonly MarkdownHeading[];
  related?: ComponentProps<typeof RelatedPosts>["posts"];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  categories,
  lang,
  alternates,
  preloadImage,
  heroImage,
  readingTime,
  headings = [],
  related = [],
} = Astro.props;

// Datos estructurados para Google (#211). Las URL contra `Astro.site`, como
// en BaseHead: detrás del proxy de Render `Astro.url` llega como http://.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate?.toISOString(),
  dateModified: (updatedDate ?? pubDate)?.toISOString(),
  author: { "@type": "Person", name: "Rodrigo Erades", url: Astro.site?.href },
  image: new URL(heroImage ?? "/area73-small.png", Astro.site).href,
  inLanguage: lang,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
// `<` escapado para que un título con `</script>` no cierre la etiqueta.
const jsonLdHtml = JSON.stringify(jsonLd).replaceAll("<", "\\u003c");
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      alternates={alternates}
      preloadImage={preloadImage}
    />
    <script is:inline type="application/ld+json" set:html={jsonLdHtml} />
  </head>

  <body class="bg-background text-foreground min-h-screen flex flex-col">
    <Header lang={lang} />
    <main class="max-w-[1200px] mx-auto py-8 w-[calc(100%-2em)]">
      <article class="pb-8">
        <div class="prose w-[1200] max-w-[calc(100%-2em)] mx-auto p-4">
          <ShowWhen when={pubDate}>
            <div class="mb-6 py-4 text-center leading-none">
              <h1
                class="font-serif text-4xl font-bold text-foreground mb-6 vt-post-title"
                data-testid="post-title"
              >
                {title}
              </h1>
              <hr />
              <div class="flex items-center justify-between my-2">
                <div>
                  <!-- El «·» vive en el padding izquierdo del tiempo de
                       lectura: si salta de línea, ese padding cae en el -ml-4
                       y overflow-hidden lo recorta. Sin JS ni media queries. -->
                  <div class="overflow-hidden">
                    <div class="flex flex-wrap -ml-4">
                      <span class="pl-4">
                        <FormattedDate date={pubDate!} lang={lang} />
                      </span>
                      <ShowWhen when={readingTime}>
                        <span
                          class="relative pl-4 before:absolute before:left-1.5 before:content-['·']"
                        >
                          <ReadingTime minutes={readingTime!} lang={lang} />
                        </span>
                      </ShowWhen>
                    </div>
                  </div>
                  <ShowWhen when={updatedDate}>
                    <div class="italic text-xs">
                      Last updated on <FormattedDate
                        date={updatedDate!}
                        lang={lang}
                      />
                    </div>
                  </ShowWhen>
                </div>
                <div class="flex flex-wrap gap-2 justify-end">
                  {
                    (tags ?? []).map((tag) => (
                      <span class="bg-muted px-2 py-1 rounded-full">{tag}</span>
                    ))
                  }
                </div>
              </div>
            </div>
          </ShowWhen>
          <TableOfContents headings={headings} lang={lang} />
          <div class="prose max-w-none">
            <slot />
          </div>
        </div>
      </article>
      <RelatedPosts posts={related} lang={lang} />
    </main>
    <Footer lang={lang as "es" | "en"} />
  </body>
</html>
